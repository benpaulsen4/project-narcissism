---
import { buildEdges, edgeKey, type GraphNode } from "../lib/graph";
import { careerYears } from "../lib/dates";
import { posFor, type MapVariant, type SiteNode } from "../lib/nodes";
import { FIT_SCALE } from "../scripts/panzoom";
import Legend from "./Legend.astro";
import NodeChip from "./NodeChip.astro";

interface Props {
  nodes: SiteNode[];
  activeId: string;
  variant: MapVariant;
}

const { nodes, activeId, variant } = Astro.props;
const mobile = variant === "mobile";

const edges = buildEdges(nodes as GraphNode[]);
const byId = new Map(nodes.map((n) => [n.id, n]));
const posOf = (id: string) => posFor(byId.get(id)!, variant);

// The SVG stretches to its container (preserveAspectRatio="none"), so viewBox
// units and the chips' percentage offsets stay aligned at any size.
const VW = 1000;
const VH = 1000;
---

<div
  id={mobile ? "bpGM" : "bpG"}
  data-map
  class="relative overflow-hidden bg-[radial-gradient(rgba(255,255,255,.05)_1px,transparent_1px)]"
  class:list={[
    mobile
      ? // The map takes whatever the column gives it, which is now
        // everything below the header and the legend strip. It used to be
        // capped at `min(392px, 100dvh - 260px)` because the reading panel
        // shared the column and needed a floor of its own — on a landscape
        // phone that arithmetic left the map a 130px letterbox. The panel
        // is an overlay now (see Screen.astro), so there is nothing left to
        // budget against and the cap goes with it.
        "h-full touch-none bg-[size:28px_28px]"
      : // The desktop chips size themselves off this element's width — see
        // the scale unit in NodeChip.astro.
        "[container-type:inline-size] h-full bg-[size:34px_34px]",
  ]}
>
  <div
    id={mobile ? "bpGMinner" : undefined}
    data-map-inner
    class="absolute inset-0 origin-center"
    style={mobile ? `transform:scale(${FIT_SCALE})` : undefined}
  >
    <svg
      viewBox={`0 0 ${VW} ${VH}`}
      preserveAspectRatio="none"
      class="absolute inset-0 h-full w-full"
      aria-hidden="true"
    >
      <g
        fill="none"
        stroke="currentColor"
        class="text-ink/20 [stroke-dasharray:5_7] motion-safe:[animation:bpDash_24s_linear_infinite]"
        stroke-width={mobile ? 1.1 : 1.3}
      >
        {
          edges.map((e) => {
            const a = posOf(e.a);
            const b = posOf(e.b);
            return (
              <line
                data-edge={edgeKey(e)}
                x1={a.x * VW}
                y1={a.y * VH}
                x2={b.x * VW}
                y2={b.y * VH}
              />
            );
          })
        }
      </g>
    </svg>

    {
      nodes.map((node) => (
        <NodeChip node={node} variant={variant} active={node.id === activeId} />
      ))
    }
  </div>

  {
    !mobile && (
      <>
        <p class="text-ink/34 absolute top-[22px] left-[26px] z-4 m-0 font-mono text-[11px] font-medium tracking-[0.16em]">
          CLICK ANY NODE FOR DETAILS
        </p>
        <div class="absolute bottom-[22px] left-[26px] z-4">
          <Legend variant="desktop" />
        </div>
        <p class="text-ink/28 absolute right-[26px] bottom-[22px] z-4 m-0 font-mono text-[10.5px]">
          {nodes.length} nodes · {edges.length} edges · uptime{" "}
          <span data-career-years>{careerYears()}</span>
          yrs
        </p>
      </>
    )
  }

  {
    mobile && (
      <>
        {/* Two lines sharing one grid cell, crossfaded by `data-hint`. The
            shared cell is what keeps the box sized to the longer of them
            from the start, so the swap several seconds into a visit cannot
            move or resize the corner it sits in. The pan/zoom line is the
            one the server renders as visible, so nothing here depends on
            the hint script running. */}
        <p
          data-map-hint
          class="pointer-events-none absolute top-2.5 left-4 z-6 m-0 grid font-mono text-[8.5px] font-medium tracking-[0.12em]"
        >
          <span data-hint-pan class="text-ink/30 col-start-1 row-start-1">
            DRAG TO PAN · PINCH TO ZOOM
          </span>
          <span data-hint-tap class="text-accent col-start-1 row-start-1">
            TAP ANY NODE TO READ MORE
          </span>
        </p>
        {/* The legend shares the bottom edge with the zoom controls
            opposite, and on one line the pair needs 374px of width — so
            below that the legend wraps rather than colliding. The 148px
            reserved here is the room the other end of that edge needs:
            113px of controls, their 12px offset from the right, this
            legend's own 16px offset from the left, and ~7px of gap
            between the two. Keep it in step with those offsets. The
            two-line case still fits inside the vertical room
            `EDGE_PADDING.bottom` in panzoom.ts reserves, so a panned chip
            cannot come to rest under it. */}
        <div
          data-legend
          class="absolute bottom-2.5 left-4 z-6 max-w-[calc(100%-148px)]"
        >
          <Legend variant="mobile" />
        </div>
        <div
          data-zoom-controls
          class="absolute right-3 bottom-2.5 z-6 flex gap-1.5"
        >
          <button
            type="button"
            data-zoom="out"
            aria-label="Zoom out"
            class="bg-canvas/82 text-ink size-[30px] rounded-lg border border-white/16 font-mono text-[15px] font-medium"
          >
            −
          </button>
          <button
            type="button"
            data-zoom="reset"
            aria-label="Fit map"
            class="bg-canvas/82 text-ink h-[30px] rounded-lg border border-white/16 px-2.5 font-mono text-[9px] font-medium tracking-[0.1em]"
          >
            FIT
          </button>
          <button
            type="button"
            data-zoom="in"
            aria-label="Zoom in"
            class="bg-canvas/82 text-ink size-[30px] rounded-lg border border-white/16 font-mono text-[15px] font-medium"
          >
            +
          </button>
        </div>
      </>
    )
  }
</div>
