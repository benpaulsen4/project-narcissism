---
import Base from "../layouts/Base.astro";
---

<!--
  No canonicalPath: static output serves this file at `/404` with a 200, so
  the route is crawlable and a self-canonical would have been an active
  invitation to index it. `noindex` withdraws it properly — sitemap exclusion
  alone does not, because a canonical is the stronger signal of the two.
-->
<Base title="Not found — Ben Paulsen" description="That page does not exist.">
  <meta slot="head" name="robots" content="noindex" />
  <main
    class="flex h-dvh flex-col items-center justify-center gap-4 px-6 text-center"
  >
    <p
      class="text-ink/38 m-0 font-mono text-[11px] font-medium tracking-[0.2em]"
    >
      404 · NODE NOT FOUND
    </p>
    <h1 class="font-display m-0 text-[34px] font-bold tracking-[-0.03em]">
      Nothing is wired to this address.
    </h1>
    <a
      href="/"
      class="bg-accent text-canvas mt-2 rounded-full px-[17px] py-2.5 font-mono text-[12px] font-medium no-underline"
    >
      back to the map
    </a>
  </main>
</Base>
