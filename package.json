    "astro": "7.2.2",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@fontsource/space-grotesk": "5.3.0",
    "@playwright/test": "1.62.1",
    "astro-eslint-parser": "3.1.0",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "3.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
