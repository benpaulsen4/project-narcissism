---
import { posFor, type MapVariant, type SiteNode } from "../lib/nodes";
import { statusWord } from "../lib/dates";

interface Props {
  node: SiteNode;
  variant: MapVariant;
  active: boolean;
}

const { node, variant, active } = Astro.props;
const mobile = variant === "mobile";
const status = statusWord();
const pos = posFor(node, variant);
const href = node.id === "ben" ? "/" : `/${node.id}`;

const dotClass = {
  core: "bg-accent",
  capability: "bg-cap",
  project: "bg-accent",
  job: "bg-job",
  education: "bg-edu",
}[node.kind];

// The mobile chip keeps fixed pixel metrics — its map is full-bleed and has
// pan/zoom, so it never has to survive a narrowing column. The desktop chip
// does, so its metrics come from the `chip*` rules below, which scale with
// the map. See the <style> block for why.
const box = mobile
  ? {
      root: "rounded-xl px-3 py-2",
      row: "gap-2",
      dot: "size-1.5",
      label: "text-[11.5px]",
      status: "mt-1.5 text-[8.5px]",
      meta: "mt-1 text-[7.5px]",
    }
  : {
      root: "chip",
      row: "chip-row",
      dot: "chip-dot",
      label: "chip-label",
      status: "chip-status",
      meta: "chip-meta",
    };
---

<a
  href={href}
  data-node={node.id}
  data-kind={node.kind}
  data-active={active ? "" : null}
  class="group bg-chip/96 data-active:border-accent data-[kind=core]:border-accent/50 data-[kind=core]:bg-chip absolute z-3 block -translate-x-1/2 -translate-y-1/2 border border-white/13 no-underline transition-[transform,border-color,opacity] duration-300 hover:scale-105 data-dimmed:opacity-32"
  class:list={[box.root]}
  style={`left:${pos.x * 100}%;top:${pos.y * 100}%`}
>
  <span class="flex items-center" class:list={[box.row]}>
    <span class:list={["block shrink-0 rounded-full", dotClass, box.dot]}
    ></span>
    <span
      class="font-display font-semibold tracking-tight"
      class:list={[box.label]}>{node.label}</span
    >
  </span>
  {
    node.kind === "core" ? (
      <span
        data-status={mobile ? "short" : ""}
        class="text-ink/45 block font-mono"
        class:list={[box.status]}
      >
        {mobile ? `currently ${status}` : `brisbane · currently ${status}`}
      </span>
    ) : (
      <span
        class="text-ink/38 block font-mono font-medium tracking-[0.14em]"
        class:list={[box.meta]}
      >
        {node.meta}
      </span>
    )
  }
</a>

<style>
  /*
   * Every chip's position is a fraction of the map, but the desktop chips
   * were fixed pixel boxes — and their map is the `1fr` column beside a
   * fixed 440px panel, so it narrows with the viewport while the chips did
   * not. Scaling the chips down with `min(1px, 100cqw / 712)` could not fix
   * this on its own: 712 is the map width at the *old* `md` (768px)
   * breakpoint, but the layout was actually composed at a map width of 840
   * (the 1280px approved desktop view). At map=712 the chip was already at
   * its 1px cap, and 351/712 is a far tighter fit than the 351/840 the
   * design was drawn for — so the chips collided at every width in that
   * band regardless of scale, and only stopped once the map outgrew the
   * chips' cap at >=1280px.
   *
   * The real fix is structural: the desktop rendition (and this scale unit)
   * now only ever appears at `desktop:` (>=1152px, see the
   * `--breakpoint-desktop` in global.css) — the whole collision-prone band
   * below that shows the mobile rendition instead, which was built for
   * constrained space. That leaves one residual zone: between 1152px and
   * 1280px the map is still only 712–840px wide, so a design-size chip can
   * still collide there. `--chip` stays to cover it, now referenced against
   * the design's own 840 rather than the old breakpoint's 712 — so it is
   * exactly 1px (unscaled) at and above 840, matching the approved 1280px
   * view byte-for-byte, and shrinks smoothly from 840 down to the 712px
   * floor at 1152px instead of sitting pinned at full size the whole way.
   *
   * A container query on the map rather than `vw` maths keeps the map's own
   * width the single source of truth: the 440px panel is not restated here,
   * so the two cannot drift apart.
   */
  .chip {
    --chip: min(1px, 100cqw / 840);

    border-radius: calc(12 * var(--chip));
    padding: calc(12 * var(--chip)) calc(16 * var(--chip));
  }
  .chip-row {
    gap: calc(8 * var(--chip));
  }
  .chip-dot {
    width: calc(6 * var(--chip));
    height: calc(6 * var(--chip));
  }
  .chip-label {
    font-size: calc(15 * var(--chip));
  }
  .chip-status {
    margin-top: calc(6 * var(--chip));
    font-size: calc(11.5 * var(--chip));
  }
  .chip-meta {
    margin-top: calc(4 * var(--chip));
    font-size: calc(9.5 * var(--chip));
  }
</style>
