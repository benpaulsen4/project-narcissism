---
import Header from "./Header.astro";
import Legend from "./Legend.astro";
import Map from "./Map.astro";
import Panel from "./Panel.astro";
import type { SiteNode } from "../lib/nodes";

interface Props {
  nodes: SiteNode[];
  activeId: string;
}

const { nodes, activeId } = Astro.props;
---

<div class="flex h-dvh flex-col overflow-hidden">
  <Header />

  <div
    class="max-desktop:flex max-desktop:flex-col grid min-h-0 flex-1 grid-cols-[1fr_440px]"
  >
    <nav class="max-desktop:flex-none relative" aria-label="System map">
      <div class="max-desktop:hidden h-full">
        <Map nodes={nodes} activeId={activeId} variant="desktop" />
      </div>
      <div class="max-desktop:block hidden">
        <Map nodes={nodes} activeId={activeId} variant="mobile" />
      </div>
    </nav>

    <div class="max-desktop:block hidden border-y border-white/7 px-5 py-2.5">
      <Legend variant="mobile" />
    </div>

    <!-- The floor matters only on the narrow column, where the panel is the
         flexible item: it guarantees the panel keeps a readable, scrollable
         height even if the fixed pieces above it grow (a wrapped header, a
         taller legend) on a very short viewport. -->
    <div
      class="bg-panel max-desktop:min-h-[120px] max-desktop:flex-1 max-desktop:border-t max-desktop:border-l-0 relative min-h-0 border-l border-white/8"
    >
      {
        nodes.map((node) => (
          <Panel node={node} nodes={nodes} active={node.id === activeId} />
        ))
      }
    </div>
  </div>
</div>

<script>
  import { initMap } from "../scripts/map";
  import { initPanZoom } from "../scripts/panzoom";
  import { initStatus } from "../scripts/status";

  initMap();
  initPanZoom();
  initStatus();
</script>
